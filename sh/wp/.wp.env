# From script
WP_DIR=../../wordpress

# Engine: docker | host
ENGINE=docker

# Environment: local | development | staging | production
ENVIRONMENT=local

# WordPress
VERSION=6.9
DOMAIN=local.wp-boilerplate.com
LOCALE=es_ES
TITLE='Título del site'

# Admin user
ADMIN_NAME=wp_admin
ADMIN_PASSWORD='*****'

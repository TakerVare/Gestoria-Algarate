server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN} www.${DOMAIN};
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${DOMAIN} www.${DOMAIN};
    root /var/www/html${WEB_DIR};
    index index.php;
    client_max_body_size 128m;
    client_body_timeout 120;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;


    # __TLS__

    # Please configure with: https://ssl-config.mozilla.org/
    # Use the configuration proposal after writing the version of your server and OpenSSL
    ssl_certificate /etc/ssl/${DOMAIN}.pem;
    ssl_certificate_key /etc/ssl/${DOMAIN}-key.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:DHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;


    # __HARDENING__

    # HTTP methods
    if ($request_method !~ ^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$ ) {
        return 405;
    }

    # Hide the nginx version
    server_tokens off;

    # Hide the webserver technology
    proxy_hide_header X-Powered-By;

    # Disable directory listing
    autoindex off;

    # Security headers
    add_header 'Referrer-Policy' 'strict-origin-when-cross-origin' always;
    add_header 'X-Content-Type-Options' 'nosniff' always;
    add_header 'X-Frame-Options' 'SAMEORIGIN' always;
    add_header 'X-XSS-Protection' '1; mode=block' always;

    # Enable them only if you understand the implications:
    # add_header 'Strict-Transport-Security' 'max-age=31536000; includeSubDomains; preload' always;
    # add_header 'Permissions-Policy' 'accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()' always;

    # set $CSP "default-src 'self'";
    # set $CSP "${CSP}; font-src 'self'";
    # set $CSP "${CSP}; img-src 'self'";
    # set $CSP "${CSP}; style-src 'self'";
    # set $CSP "${CSP}; script-src 'self'";
    # set $CSP "${CSP}; frame-src 'self'";
    # set $CSP "${CSP}; connect-src 'self'";
    # add_header 'Content-Security-Policy' $CSP always;


    # GZIP
    gzip on;
    gzip_comp_level 6;
    gzip_proxied any;
    gzip_min_length 256;
    gzip_buffers 16 8k;
    # MIME-type: text/html is enabled and need not be included
    gzip_types application/atom+xml application/font-woff application/font-woff2 application/geo+json application/javascript application/java application/json application/ld+json application/manifest+json application/msword application/pdf application/rdf+xml application/rss+xml application/vnd.ms-access application/vnd.ms-excel application/vnd.ms-fontobject application/vnd.ms-opentype application/vnd.ms-powerpoint application/vnd.ms-project application/vnd.ms-write application/vnd.oasis.opendocument.database application/vnd.oasis.opendocument.chart application/vnd.oasis.opendocument.formula application/vnd.oasis.opendocument.graphics application/vnd.oasis.opendocument.spreadsheet application/vnd.oasis.opendocument.text application/wasm application/x-javascript application/x-msdownload application/x-font-otf application/x-font-ttf application/x-shockwave-flash application/x-web-app-manifest+json application/xhtml+xml application/xml audio/ogg audio/wav font/eot font/otf font/ttf image/bmp image/svg+xml image/tiff image/x-icon text/cache-manifest text/calendar text/css text/javascript text/markdown text/plain text/richtext text/x-js text/xsd text/xsl text/xml text/vcard text/vnd.rim.location.xloc text/vtt text/x-component text/x-cross-domain-policy video/webm;
    gzip_disable "MSIE [1-6].(?!.*SV1)";
    gzip_vary on;


    # __LOCATIONS__

    location / {
        # Prevent author sniffing (www.xxx.com/?author=1)
        if ($args ~ "^author=\d") { return 403; }

        # Include the "?$args" part so non-default permalinks doesn't break when using query string
        try_files $uri $uri/ /index.php$is_args$args;
    }

    location ~ /favicon.(ico|png|svg)$ {
        log_not_found off;
        access_log off;
        expires max;
    }

    location = /robots.txt {
        allow all;
        log_not_found off;
        access_log off;
        try_files $uri /index.php$is_args$args;
    }

    location ~ /\.(?!well-known) { deny all; }
    location ~* /(access|error)_log$ { return 404; }
    location ~ /package\.json$ { return 404; }
    location ~ /package-lock\.json$ { return 404; }
    location ~ /node_modules/ { return 404; }
    location ~* /Jenkinsfile$ { return 404; }
    location ~* (licencia|license|LICENSE|olvasdel|lisenssi|liesmich)\.(html|txt)$ { return 404; }
    location ~ /nginx\.conf$ { deny all; }
    location ~* /readme\.(html|txt|md)$ { return 404; }
    location ~* /sftp-config\.json$ { return 404; }
    location ~* (^#.*#|\.(pl|cgi|py|sh|lua|asp|bak|old|config|dist|fla|inc|ini|log|md|psd|sh|sql|sw[op])|~)$ { return 404; }
    location ~* /installer-log\.txt$ { return 404; }
    location ~* /(uploads|files)/.*\.(?:s?html?|js|php|phtml|shtml|swf)$ { return 404; }
    location ~ /composer\.json$ { return 404; }
    location ~ /composer\.lock$ { return 404; }
    location ~ ^/vendor/ { return 404; }
    location ~ ^/wp-config { return 404; }
    location ~ ^(/wp)?/wp-comments-post\.php$ { return 404; }
    location ~ ^(/wp)?/wp-cron\.php$ { return 404; }
    location ~ ^(/wp)?/wp-links-opml\.php$ { return 404; }
    location ~ ^(/wp)?/xmlrpc\.php$ { return 404; }
    location ~ /wp-admin/(install|setup-config|load-scripts|load-styles)\.php { deny all; }
    location ~ /wp-admin/includes/ { deny all; }
    location ~ /wp-admin/maint/repair\.php$ { deny all; }
    location ~* /(app|wp-content)/.*\.(zip|gz|tar|bzip2|7z)$ { deny all; }
    location = /(app|wp-content)/mu-plugins/ { return 404; }
    location = /(app|wp-content)/plugins/ { return 404; }
    location = /(app|wp-content)/themes/ { return 404; }
    location ~* /wp-includes/.*\.php$ { deny all; }
    location ~ /wp-includes/theme-compat/ { deny all; }

    # Some plugins may require direct calls (comment in that case):
    location ~* ^/(app|wp-content)/.*\.php$ { deny all; }

    # EWWW Image Optimizer
    location ~ ^/(app|wp-content)/ewww(/|$) { return 404; }

    # UpdraftPlus
    location ~ ^/(app|wp-content)/updraft(/|$) { return 404; }

    # All-In-One Security (AIOS)
    location ~ ^/(app|wp-content)/aiowps_backups(/|$) { return 404; }

    # WordFence
    location ~ \.user\.ini$ { return 404; }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass wordpress:9000;
        fastcgi_buffers 16 32k;
        fastcgi_buffer_size 64k;
        fastcgi_busy_buffers_size 64k;
        fastcgi_hide_header X-Powered-By;
        fastcgi_intercept_errors on;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";  # Mitigate https://httpoxy.org/ vulnerabilities
    }


    # serve png, jpg, jpeg as webp if available
    location ~* ^/.+\.(png|gif|jpe?g)$ {
    	add_header Vary "Accept";
    	add_header Cache-Control "public, no-transform";
    	set $img_path $1;
    	try_files $img_path$webp_ext $uri =404;
    }

    location ~* \.(css|gif|ico|jpeg|jpg|js|png|webp)$ {
            expires max;
            log_not_found off;
    }
}
